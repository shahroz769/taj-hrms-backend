NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=
MONGO_DB_NAME=tajHRMS
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# Auth
JWT_SECRET=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (optional — employee document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ZKTeco ADMS integration
ZK_ALLOWED_SERIALS=
ZK_AUTO_REGISTER_DEVICES=true
ZK_ONLINE_THRESHOLD_SECONDS=120
# Queue DATA QUERY ATTLOG when a device reconnects after being offline
ZK_REQUEST_ATTLOG_ON_RECONNECT=true
